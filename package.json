{
  "name": "roll30-nightforge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=/Roll30/",
    "build:preview": "vite build --base=/Roll30-Nightforge/",
    "preview": "vite preview",
    "catalog:generate": "node scripts/generate-phase5-catalogs.mjs",
    "monsters:generate": "node scripts/generate-monsters.mjs",
    "test": "node --test \"src/**/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:foundation": "node scripts/verify-phase1.mjs",
    "verify:library": "node scripts/verify-phase2.mjs",
    "test:library:render": "node scripts/phase2-render-smoke.mjs",
    "verify:artwork": "node scripts/verify-phase3.mjs",
    "test:artwork:render": "node scripts/phase3-render-smoke.mjs",
    "verify:heroes": "node scripts/verify-phase4.mjs",
    "test:heroes:render": "node scripts/phase4-render-smoke.mjs",
    "verify:equipment": "node scripts/verify-phase5.mjs",
    "test:equipment:render": "node scripts/phase5-render-smoke.mjs",
    "verify:map": "node scripts/verify-phase6.mjs",
    "test:map:render": "node scripts/phase6-render-smoke.mjs",
    "verify:setup": "node scripts/verify-phase7.mjs",
    "test:setup:render": "node scripts/phase7-render-smoke.mjs",
    "verify:turns": "node scripts/verify-phase8.mjs",
    "test:turns:render": "node scripts/phase8-render-smoke.mjs",
    "verify:combat": "node scripts/verify-phase9.mjs",
    "test:combat:render": "node scripts/phase9-render-smoke.mjs",
    "verify:encounter": "node scripts/verify-phase10.mjs",
    "test:encounter:render": "node scripts/phase10-render-smoke.mjs",
    "test:hardening": "node --test src/phase11.test.js",
    "test:hardening:render": "node scripts/phase11-render-smoke.mjs",
    "test:browser": "playwright test",
    "verify:hardening": "node scripts/verify-phase11.mjs",
    "verify:release": "node scripts/verify-phase12.mjs",
    "test:rules": "node --test src/rules.test.js",
    "test:rules:render": "node scripts/rules-render-smoke.mjs",
    "verify:rules": "node scripts/verify-rules.mjs",
    "test:reactions": "node --test src/reactions.test.js",
    "test:reactions:render": "node scripts/reactions-render-smoke.mjs",
    "verify:reactions": "node scripts/verify-reactions.mjs",
    "test:expansion": "node --test src/expansion.test.js",
    "test:expansion:render": "node scripts/expansion-render-smoke.mjs",
    "test:workflow-features:render": "node scripts/workflow-features-render-smoke.mjs",
    "acceptance:release": "node scripts/phase12-live-acceptance.mjs",
    "verify:dependencies": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:library:render && npm run test:artwork:render && npm run test:heroes:render && npm run test:equipment:render && npm run test:map:render && npm run test:setup:render && npm run test:turns:render && npm run test:combat:render && npm run test:encounter:render && npm run test:hardening:render && npm run test:rules:render && npm run test:reactions:render && npm run test:expansion:render && npm run test:workflow-features:render && npm run verify:foundation && npm run verify:library && npm run verify:artwork && npm run verify:heroes && npm run verify:equipment && npm run verify:map && npm run verify:setup && npm run verify:turns && npm run verify:combat && npm run verify:encounter && npm run test:browser && npm run verify:hardening && npm run verify:release && npm run verify:rules && npm run verify:reactions && npm run verify:dependencies && npm run build"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
